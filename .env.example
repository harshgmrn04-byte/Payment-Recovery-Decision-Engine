# The downloaded IBM dataset folder. It is intentionally not committed.
IBM_ARCHIVE_DIR=data

# For a local PostgreSQL installation created with `createdb failed_payments`.
DATABASE_URL=postgresql://localhost:5432/failed_payments

# Use rules by default. LLM mode is optional and falls back to rules on failure.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Only needed for the authenticated mock gateway endpoint.
GATEWAY_TOKEN=change-this-local-token
RECOVERY_RANDOM_SEED=42
